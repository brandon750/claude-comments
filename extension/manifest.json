{
	"manifest_version": 3,
	"name": "Claude Comments",
	"version": "1.3.0",
	"description": "Leave comments on local .test sites at any screen size. Each comment becomes a task for Claude Code.",
	"icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
	"permissions": ["declarativeNetRequest"],
	"host_permissions": ["<all_urls>"],
	"background": { "service_worker": "background.js" },
	"content_scripts": [
		{
			"matches": ["*://*.test/*"],
			"js": ["content.js"],
			"all_frames": true,
			"run_at": "document_idle"
		}
	],
	"action": {
		"default_title": "Toggle comment mode (⌥C)",
		"default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
	},
	"declarative_net_request": {
		"rule_resources": [{ "id": "allow-framing", "enabled": true, "path": "rules.json" }]
	}
}
